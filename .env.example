# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID from the same Developer Portal page
CLIENT_ID=

# Optional: set this during development to register slash commands to a single
# guild instantly instead of waiting up to an hour for global propagation.
GUILD_ID=

# Optional: role ID to automatically grant every new member on join.
# Leave blank to disable auto-role.
AUTO_ROLE_ID=

# Required for the /tarkov command to work: only members holding this role
# may use it. Create a role (e.g. "Tarkov-Access"), copy its ID
# (right click the role in Server Settings > Roles > ... > Copy Role ID,
# Developer Mode must be enabled), and paste it here.
TARKOV_ACCESS_ROLE_ID=

# Optional: comma-separated Discord user IDs that can always use /tarkov,
# regardless of TARKOV_ACCESS_ROLE_ID.
TARKOV_ACCESS_USER_IDS=

# Optional: set to "false" to disable the daily auto-update check (git fetch
# + fast-forward pull + restart). Only works if the bot was deployed via
# `git clone` with an "origin" remote configured. Default: enabled.
AUTO_UPDATE=
